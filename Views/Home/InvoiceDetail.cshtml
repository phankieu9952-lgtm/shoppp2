@model IEnumerable<shoppp2.Models.InvoiceDetail>
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
}

<div class="container mt-4">
    <h2 class="text-secondary mb-3">Chi Tiết Hóa Đơn</h2>
    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Mã hóa đơn (InvoiceId)</th>
                <th>Mã sản phẩm (ProductId)</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var thanhTien = item.Quantity * item.UnitPrice;
                <tr>
                    <td>@item.Id</td>
                    <td>@item.InvoiceId</td>
                    <td>@item.ProductId</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                    <td class="fw-bold text-success">@thanhTien.ToString("N0") VNĐ</td>
                </tr>
            }
        </tbody>
    </table>
</div>